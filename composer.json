{
    "name": "leowebguy/lorem-ipsum",
    "description": "Lorem Ipsum Generator for Craft",
    "keywords": [
        "lorem ipsum",
        "lorem",
        "ipsum",
        "twig",
        "templating",
        "extension",
        "utils"
    ],
    "version": "2.1.0",
    "type": "craft-plugin",
    "license": "proprietary",
    "authors": [
        {
            "name": "Leo",
            "homepage": "https://github.com/leowebguy"
        }
    ],
    "support": {
        "docs": "https://github.com/leowebguy/lorem-ipsum/blob/main/README.md",
        "issues": "https://github.com/leowebguy/lorem-ipsum/issues"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "craftcms/cms": "^5.0.0",
        "joshtronic/php-loremipsum": "^2.1.0 || ^3.0"
    },
    "require-dev": {
        "craftcms/ecs": "dev-main",
        "craftcms/phpstan": "dev-main",
        "craftcms/rector": "dev-main",
        "laravel/pint": "^1.14.0"
    },
    "autoload": {
        "psr-4": {
            "leowebguy\\loremipsum\\": "src/"
        }
    },
    "extra": {
        "name": "Lorem Ipsum",
        "handle": "lorem-ipsum",
        "developer": "Leo",
        "developerUrl": "https://github.com/leowebguy",
        "documentationUrl": "https://github.com/leowebguy/lorem-ipsum/blob/main/README.md",
        "class": "leowebguy\\loremipsum\\Plugin"
    },
    "config": {
        "platform": {
            "php": "8.2"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "craftcms/plugin-installer": true
        }
    },
    "scripts": {
        "check-cs": "vendor/bin/ecs check src --ansi",
        "fix-cs": "vendor/bin/ecs check src --ansi --fix",
        "phpstan": "vendor/bin/phpstan analyse src",
        "rector": "vendor/bin/rector process src --config vendor/craftcms/rector/sets/craft-cms-50.php",
        "pint": "vendor/bin/pint -v src"
    }
}
